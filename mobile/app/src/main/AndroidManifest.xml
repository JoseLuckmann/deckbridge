<?xml version="1.0" encoding="utf-8"?>
<!-- Modo Biblioteca do app DeckBridge (ADR-0012). O processo ":biblioteca" é dado pelo app (android/app), que decide
     como os modos se dividem; aqui não, porque o Robolectric, com a atividade noutro processo, não devolvia à tela o
     resultado de trabalho em segundo plano (ShowFlowTest). A entrada do app (StartActivity) abre este modo ou o de DJ. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vibração curta ao marcar (nota, playlist). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application>
        <activity
            android:name=".ManagerActivity"
            android:label="@string/launcher_name"
            android:theme="@style/Theme.DeckBridgeBiblioteca"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Compartilhar músicas de outro app (arquivos, WhatsApp, Drive) direto para a biblioteca. -->
            <intent-filter android:label="@string/share_import">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>
